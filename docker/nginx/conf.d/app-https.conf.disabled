# Enable HTTPS by renaming this file to: app-https.conf
# Requires that Certbot has issued certificates into /etc/letsencrypt.

server {
    listen 443 ssl;
    server_name sibugaydevgroup.tech www.sibugaydevgroup.tech;

    ssl_certificate     /etc/letsencrypt/live/sibugaydevgroup.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sibugaydevgroup.tech/privkey.pem;

    # Reasonable modern defaults
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Optional hardening (enable when you're sure HTTPS is stable)
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Avoid 413 Request Entity Too Large
    client_max_body_size 30m;

    location / {
        proxy_pass http://app:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# After enabling HTTPS, you probably want HTTP -> HTTPS redirect.
# In docker/nginx/conf.d/app-http.conf, replace the location / block with:
#   return 301 https://$host$request_uri;
