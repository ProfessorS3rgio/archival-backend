// Current application schema from database/migrations (including additive migrations).
// Physical table names remain compatible with deployed data and existing routes.
Project archival_backend {
  database_type: 'MySQL'
}

Enum users_role {
  "admin"
  "staff"
  "user"
  "legislator"
}
Enum sangguniang_panlalawigan_members_district {
  "1st District"
  "2nd District"
  "Ex-Officio"
}
Enum sangguniang_panlalawigan_members_extension {
  "Hon"
  "Atty"
  "Judge"
  "Doc"
}

Table personal_access_tokens {
  id "bigint unsigned" [pk, increment, not null]
  tokenable_type varchar(255) [not null]
  tokenable_id "bigint unsigned" [not null]
  name varchar(255) [not null]
  token varchar(64) [unique, not null]
  abilities text [null]
  last_used_at timestamp [null]
  expires_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  indexes {
    (tokenable_type, tokenable_id)
  }
}

Table users {
  profile_picture_path varchar(255) [null]
  id "bigint unsigned" [pk, increment, not null]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  username varchar(255) [unique, not null]
  role users_role [not null, default: 'user']
  password varchar(255) [not null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table api_clients {
  id "bigint unsigned" [pk, increment, not null]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table resolution_lists {
  resolution_id "bigint unsigned" [pk, increment, not null]
  resolution_draft_id "bigint unsigned" [null]
  resolution_no varchar(255) [null]
  added_by "bigint unsigned" [not null]
  author varchar(255) [null]
  session varchar(255) [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  date_approved date [null]
  is_municipal boolean [not null, default: false]
  municipality varchar(255) [null]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table resolution_files {
  file_id "bigint unsigned" [pk, increment, not null]
  resolution_id "bigint unsigned" [not null]
  uploaded_by "bigint unsigned" [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  updated_at timestamp [null]
  uploaded_at timestamp [null, default: `CURRENT_TIMESTAMP`]
}

Table sessions {
  id varchar(255) [pk, not null]
  user_id "bigint unsigned" [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int [not null]

  indexes {
    user_id
    last_activity
  }
}

Table ordinance_lists {
  ordinance_id "bigint unsigned" [pk, increment, not null]
  ordinance_draft_id "bigint unsigned" [null]
  added_by "bigint unsigned" [not null]
  ordinance_no varchar(255) [null]
  author varchar(255) [null]
  session varchar(255) [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  date_approved date [null]
  is_municipal boolean [not null, default: false]
  municipality varchar(255) [null]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table ordinance_files {
  file_id "bigint unsigned" [pk, increment, not null]
  ordinance_id "bigint unsigned" [not null]
  uploaded_by "bigint unsigned" [null]
  year int [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  uploaded_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
}

Table resolution_draft {
  resolution_draft_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  year int [null]
  author varchar(255) [null]
  session varchar(255) [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  date_drafted timestamp [null]
  status varchar(255) [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table resolution_draft_files {
  file_id "bigint unsigned" [pk, increment, not null]
  resolution_draft_id "bigint unsigned" [not null]
  uploaded_by "bigint unsigned" [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  uploaded_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
}

Table settings {
  id "bigint unsigned" [pk, increment, not null]
  auto_fill boolean [not null, default: true]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table ordinance_draft {
  ordinance_draft_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  year int [null]
  author varchar(255) [null]
  session varchar(255) [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  date_drafted timestamp [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  status varchar(255) [null]
  updated_at timestamp [null]
}

Table ordinance_draft_files {
  file_id "bigint unsigned" [pk, increment, not null]
  ordinance_draft_id "bigint unsigned" [not null]
  uploaded_by "bigint unsigned" [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  uploaded_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
}

Table accomplish_lists {
  Note: 'Administrative Cases'
  accomplish_id "bigint unsigned" [pk, increment, not null]
  uploaded_by "bigint unsigned" [not null]
  title varchar(255) [null]
  accomplishment_year date [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  date_uploaded timestamp [null, default: `CURRENT_TIMESTAMP`]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
  respondent varchar(255) [null]
  complainant varchar(255) [null]
}

Table project_lists {
  Note: 'Boundary Disputes; parties identify municipalities or barangays'
  project_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  code_no int [null]
  district varchar(255) [null]
  location varchar(255) [null]
  project_name varchar(255) [null]
  source_fund varchar(255) [null]
  source_type varchar(255) [null]
  amount decimal(12,2) [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
  year year [null]
  respondent varchar(255) [null]
  complainant varchar(255) [null]
}

Table committee_categories {
  committee_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  committee_name varchar(255) [null]
  description text [null]
  is_active boolean [not null, default: true]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
}

Table committee_reports {
  report_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  committee_report_no varchar(255) [null]
  subject varchar(255) [null]
  title text [null]
  year int [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_type varchar(255) [null]
  file_size bigint [null]
  extracted_text text [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table moa_lists {
  moa_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  resolution_no varchar(255) [null]
  date_received date [null]
  title varchar(255) [null]
  year int [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size bigint [null]
  file_type varchar(255) [null]
  date_uploaded timestamp [null]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table municipalities_communication_lists {
  municipalitites_communication_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  year int [null]
  date_received date [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size "bigint unsigned" [null]
  file_type varchar(255) [null]
  date_uploaded timestamp [null, default: `CURRENT_TIMESTAMP`]
  extracted_text longtext [null]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table national_offices_list {
  national_offices_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  provincial_resolution_no varchar(255) [null]
  year int [null]
  subject varchar(255) [null]
  date_received date [null]
  title varchar(255) [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size "bigint unsigned" [null]
  file_type varchar(255) [null]
  date_uploaded timestamp [null, default: `CURRENT_TIMESTAMP`]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table provincial_offices_list {
  provincial_offices_list_id "bigint unsigned" [pk, increment, not null]
  added_by "bigint unsigned" [not null]
  year int [null]
  title varchar(255) [null]
  subject varchar(255) [null]
  Date_received date [null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_size "bigint unsigned" [null]
  file_type varchar(255) [null]
  date_uploaded timestamp [null, default: `CURRENT_TIMESTAMP`]
  extracted_text longtext [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [null]
  is_visible boolean [not null, default: true]
  last_modified_by "bigint unsigned" [null]
  last_modified_at timestamp [null]
}

Table cache {
  key varchar(255) [pk, not null]
  value mediumtext [not null]
  expiration int [not null]
}

Table cache_locks {
  key varchar(255) [pk, not null]
  owner varchar(255) [not null]
  expiration int [not null]
}

Table system_logs {
  log_id "bigint unsigned" [pk, increment, not null]
  user_id "bigint unsigned" [null]
  action varchar(100) [not null]
  target_table varchar(255) [null]
  target_id "bigint unsigned" [null]
  description text [null]
  old_values text [null, note: 'JSON encoded old values for potential rollback']
  new_values text [null, note: 'JSON encoded new values']
  ip_address varchar(100) [null]
  user_agent text [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (action, target_table, target_id)
  }
}

Table sangguniang_panlalawigan_terms {
  term_id "bigint unsigned" [pk, increment, not null]
  term_no varchar(255) [null]
  start_year date [null]
  end_year date [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
}

Table sangguniang_panlalawigan_members {
  member_id "bigint unsigned" [pk, increment, not null]
  term_id "bigint unsigned" [not null]
  district sangguniang_panlalawigan_members_district [null]
  full_name varchar(255) [null]
  extension sangguniang_panlalawigan_members_extension [null]
  position varchar(255) [null]
  created_at timestamp [null, default: `CURRENT_TIMESTAMP`]
}

Table sp_profile_pictures {
  sp_profile_pictures_id "bigint unsigned" [pk, increment, not null]
  sp_member_id "bigint unsigned" [not null]
  added_by "bigint unsigned" [not null]
  file_name varchar(255) [null]
  file_url varchar(255) [null]
  file_type varchar(255) [null]
  date_uploaded timestamp [null, default: `CURRENT_TIMESTAMP`]
  disk varchar(20) [not null, default: 'public']
}

Ref: resolution_lists.added_by > users.id [delete: cascade]
Ref: resolution_lists.last_modified_by > users.id [delete: set null]
Ref: resolution_files.resolution_id > resolution_lists.resolution_id [delete: cascade]
Ref: resolution_files.uploaded_by > users.id [delete: set null]
Ref: ordinance_lists.added_by > users.id [delete: cascade]
Ref: ordinance_lists.last_modified_by > users.id [delete: set null]
Ref: ordinance_files.ordinance_id > ordinance_lists.ordinance_id [delete: cascade]
Ref: ordinance_files.uploaded_by > users.id [delete: set null]
Ref: resolution_draft.added_by > users.id [delete: cascade]
Ref: resolution_draft.last_modified_by > users.id [delete: set null]
Ref: resolution_draft_files.resolution_draft_id > resolution_draft.resolution_draft_id [delete: cascade]
Ref: resolution_draft_files.uploaded_by > users.id [delete: set null]
Ref: ordinance_draft.added_by > users.id [delete: cascade]
Ref: ordinance_draft_files.ordinance_draft_id > ordinance_draft.ordinance_draft_id [delete: cascade]
Ref: ordinance_draft_files.uploaded_by > users.id [delete: set null]
Ref: accomplish_lists.uploaded_by > users.id [delete: cascade]
Ref: accomplish_lists.last_modified_by > users.id [delete: set null]
Ref: project_lists.added_by > users.id [delete: cascade]
Ref: project_lists.last_modified_by > users.id [delete: set null]
Ref: committee_categories.added_by > users.id [delete: cascade]
Ref: committee_reports.added_by > users.id [delete: cascade]
Ref: committee_reports.last_modified_by > users.id [delete: set null]
Ref: moa_lists.added_by > users.id [delete: cascade]
Ref: moa_lists.last_modified_by > users.id [delete: set null]
Ref: municipalities_communication_lists.added_by > users.id [delete: cascade]
Ref: municipalities_communication_lists.last_modified_by > users.id [delete: set null]
Ref: national_offices_list.added_by > users.id [delete: cascade]
Ref: national_offices_list.last_modified_by > users.id [delete: set null]
Ref: provincial_offices_list.added_by > users.id [delete: cascade]
Ref: provincial_offices_list.last_modified_by > users.id [delete: set null]
Ref: system_logs.user_id > users.id [delete: set null]
Ref: sangguniang_panlalawigan_members.term_id > sangguniang_panlalawigan_terms.term_id [delete: cascade]
Ref: sp_profile_pictures.sp_member_id > sangguniang_panlalawigan_members.member_id [delete: cascade]
Ref: sp_profile_pictures.added_by > users.id [delete: cascade]
